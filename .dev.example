# 服务端专用：复制为项目根目录 .dev，禁止使用 VITE_ 前缀。
ASSISTANT_ENABLED=true
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_API_KEY=
LLM_MODEL=deepseek-ai/DeepSeek-V4-Flash
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=4096
ASSISTANT_TIMEOUT_SECONDS=180
# 相对 backend/；绝对路径也可。
ASSISTANT_CONFIG=config/assistant.toml
# 胶囊 AI 报告：流式接收间隔、整次生成时限、输出 token 上限（含模型推理预算）。
REPORT_LLM_READ_TIMEOUT_SECONDS=120
REPORT_ANALYSIS_TIMEOUT_SECONDS=300
REPORT_LLM_MAX_TOKENS=8192
